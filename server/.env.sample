# Copy to .env and fill in real values. NEVER commit the real .env file.

# Port the API listens on
PORT=5000

# MongoDB connection string
MONGO_URI="mongodb://localhost:27017/instagram-clone"

# SendGrid API key, used to send password-reset emails
SENDGRID_API_KEY=""

# SECURITY (VULN-05): the JWT signing key.
# Must be at least 32 characters of high-entropy random data - the server
# refuses to start otherwise. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=""

# Comma-separated list of browser origins allowed to call this API (VULN-09).
CORS_ORIGINS="http://localhost:3000"

# Number of reverse-proxy hops in front of the app (VULN-07).
# Leave unset when the app is exposed directly. Set to the exact hop count
# (e.g. 1 behind a single nginx) when it is not. Never set this to "true".
# TRUST_PROXY=1

# "development" or "production"
NODE_ENV=development

# ---------------------------------------------------------------------
# Google OAuth 2.0 / OpenID Connect - see OAUTH.md for setup
# Obtain these from https://console.cloud.google.com/apis/credentials
# The redirect URI must match the one registered with Google EXACTLY.
# ---------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:5000/auth/google/callback"

# Where the user is sent back to in the React app after a successful login
CLIENT_OAUTH_SUCCESS_URL="http://localhost:3000/oauth/callback"

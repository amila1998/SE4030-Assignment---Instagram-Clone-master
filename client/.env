# SECURITY (VULN-12): stop CRA inlining the webpack runtime into index.html.
# The Content-Security-Policy in public/index.html uses `script-src 'self'`,
# which blocks inline scripts - including CRA's own. Emitting the runtime as a
# separate file keeps the strict policy workable.
INLINE_RUNTIME_CHUNK=false

# Base URL of the API. Overridden per environment at build time.
REACT_APP_API_BASE=http://localhost:5000
